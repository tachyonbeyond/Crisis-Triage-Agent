# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Bedrock API key (bedrock:InvokeModel). Never read, print or log this value.
AWS_BEARER_TOKEN_BEDROCK=

AWS_DEFAULT_REGION=us-east-1

# Verified 2026-10-17 by scripts/smoke_bedrock.py on this machine.
# The plain ID `anthropic.claude-haiku-4-5-20251001-v1:0` is REJECTED for on-demand
# throughput ("Invocation of model ID ... isn't supported. Retry your request with
# the ID or ARN of an inference profile"); the `us.` prefixed profile works in both
# boto3 `converse` and the Strands BedrockModel wrapper. See docs/GROUND_TRUTH.md.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local Decider 2B server (see docs/DECIDER.md for the serve command).
DECIDER_URL=http://127.0.0.1:8000
DECIDER_TIMEOUT_S=30

# Confidence bands for Decider's is_emergency probability.
#
# These are NOT the documented 0.75/0.25 guesses -- those are unusable here. The
# model's measured range on our 22 fixtures is 0.0791..0.8551 with crisis median
# 0.2616 and a check-in case reaching 0.1765, so no threshold separates the classes;
# see docs/GROUND_TRUTH.md section 4 and results/fixtures_decider.json.
#
# These values therefore control TONE only. They are not a safety boundary: safety
# routing is the OR of the Bedrock check, the high band, escalation, and a Decider
# failure. Raising HIGH makes the tone classifier more conservative, nothing more.
CRISIS_HIGH=0.30
CRISIS_LOW=0.15
# Escalation threshold. Crisis cases measured 0.5080..0.7962 vs calm 0.2689..0.6150,
# so this overlaps too -- another reason it is a contributing signal, not the gate.
CRISIS_ESC=0.70

# Set to 0 to treat a failed safety check as "not an emergency". Default is 1
# (fail safe): if Bedrock cannot answer, assume the person needs resources.
SAFETY_FAIL_CLOSED=1