# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Bedrock API key (bedrock:InvokeModel). Never read, print or log this value.
AWS_BEARER_TOKEN_BEDROCK=

AWS_DEFAULT_REGION=us-east-1

# Verified 2026-10-17 by scripts/smoke_bedrock.py on this machine.
# The plain ID `anthropic.claude-haiku-4-5-20251001-v1:0` is REJECTED for on-demand
# throughput ("Invocation of model ID ... isn't supported. Retry your request with
# the ID or ARN of an inference profile"); the `us.` prefixed profile works in both
# boto3 `converse` and the Strands BedrockModel wrapper. See docs/GROUND_TRUTH.md.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local Decider 2B server (see docs/DECIDER.md for the serve command).
DECIDER_URL=http://127.0.0.1:8000
DECIDER_TIMEOUT_S=30

# Confidence bands. NOT yet set: the documented 0.75/0.25 guesses do not fit this
# model's measured output scale. Values come from results/fixtures_decider.json --
# see docs/GROUND_TRUTH.md for what the sweep found.
# CRISIS_HIGH=
# CRISIS_LOW=
# CRISIS_ESC=